# --- Base de données (PostgreSQL standard : local, Supabase ou Scaleway) ---
# Local :    postgresql://sicaap:sicaap@localhost:5432/sicaap_salles
# Supabase : chaîne "Session pooler" ou "Direct connection" du projet
DATABASE_URL="postgresql://sicaap:sicaap@localhost:5432/sicaap_salles"

# --- Premier administrateur (utilisé par `npm run db:seed`) ---
SEED_ADMIN_EMAIL="a.texier@sicaap.com"
SEED_ADMIN_NAME="Administrateur SICAAP"
# Laisser vide pour générer un mot de passe provisoire affiché dans la console.
SEED_ADMIN_PASSWORD=""

# --- E-mails ---
# console : les e-mails (et fichiers .ics) sont écrits dans les logs.
# smtp    : envoi réel (ex. Microsoft 365 : smtp.office365.com, port 587).
MAIL_TRANSPORT="console"
MAIL_FROM="Réservations SICAAP <reservations@sicaap.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# URL publique de l'application (liens dans les e-mails).
APP_URL="http://localhost:3000"
